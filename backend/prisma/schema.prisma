generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// Overdue is intentionally not here - it is derived from dueDate when invoices are read.
enum InvoiceStatus {
  Draft
  Pending
  Paid
  // the rest of the balance was written off as uncollectable
  WrittenOff
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullname     String
  createdAt    DateTime   @default(now()) @map("created_at")
  invoices     Invoice[]
  payments     Payment[]
  writeOffs    WriteOff[]

  @@map("users")
}

model Invoice {
  id               String        @id @default(uuid()) @map("invoice_id") @db.Uuid
  invoiceNumber    String        @unique @map("invoice_number")
  invoiceReference String?       @map("invoice_reference")
  invoiceDate      DateTime      @map("invoice_date") @db.Date
  dueDate          DateTime      @map("due_date") @db.Date
  currency         String        @db.Char(3)
  currencySymbol   String        @map("currency_symbol")
  description      String?
  status           InvoiceStatus @default(Draft)
  // When it was marked as sent (Draft -> Pending); null while still a Draft
  sentAt           DateTime?     @map("sent_at")

  // Customer is kept on the invoice row (see README for reasoning)
  customerName    String  @map("customer_name")
  customerEmail   String  @map("customer_email")
  customerMobile  String? @map("customer_mobile")
  customerAddress String? @map("customer_address")

  taxRate         Decimal @map("tax_rate") @db.Decimal(5, 2)
  subTotal        Decimal @map("sub_total") @db.Decimal(12, 2)
  totalTax        Decimal @map("total_tax") @db.Decimal(12, 2)
  totalDiscount   Decimal @map("total_discount") @db.Decimal(12, 2)
  totalAmount     Decimal @map("total_amount") @db.Decimal(12, 2)
  totalPaid       Decimal @default(0) @map("total_paid") @db.Decimal(12, 2)
  /// Bad debt, bank charges etc. that will never be received
  totalWrittenOff Decimal @default(0) @map("total_written_off") @db.Decimal(12, 2)
  /// totalAmount - totalPaid - totalWrittenOff
  balanceAmount   Decimal @map("balance_amount") @db.Decimal(12, 2)

  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by") @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])

  items     InvoiceItem[]
  payments  Payment[]
  writeOffs WriteOff[]

  @@index([status, dueDate])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([totalAmount])
  // GIN trigram indexes back the case-insensitive partial search
  @@index([invoiceNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "invoices_invoice_number_trgm_idx")
  @@index([customerName(ops: raw("gin_trgm_ops"))], type: Gin, map: "invoices_customer_name_trgm_idx")
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int
  rate      Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}

enum PaymentMethod {
  BankTransfer
  Cash
  BankRemittance
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceId      String        @map("invoice_id") @db.Uuid
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Total settled against the invoice, in the invoice currency:
  /// amountReceived x exchangeRate + taxWithheld
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  /// What actually arrived, in the currency it arrived in
  amountReceived Decimal       @map("amount_received") @db.Decimal(12, 2)
  currency       String        @db.Char(3)
  /// 1 unit of `currency` = exchangeRate units of the invoice currency (1 when the same)
  exchangeRate   Decimal       @map("exchange_rate") @db.Decimal(18, 6)
  /// Tax the customer withheld and pays to the tax office (TDS/WHT), in the invoice currency
  taxWithheld    Decimal       @default(0) @map("tax_withheld") @db.Decimal(12, 2)
  paidAt         DateTime      @map("paid_at") @db.Date
  note           String?
  createdAt      DateTime      @default(now()) @map("created_at")
  createdById    String        @map("created_by") @db.Uuid
  createdBy      User          @relation(fields: [createdById], references: [id])
  writeOff       WriteOff?

  @@index([invoiceId])
  @@map("payments")
}

enum WriteOffReason {
  // closing the whole balance
  BadDebt
  Dispute
  // a small gap left by a payment
  BankCharges
  ExchangeDifference
  Rounding
  SettlementDiscount
  Other
}

/// Part of the balance that will never be collected. Either the whole rest of
/// the balance (invoice becomes WrittenOff) or the gap left by a payment
/// (paymentId set; invoice becomes Paid).
model WriteOff {
  id           String         @id @default(uuid()) @db.Uuid
  invoiceId    String         @map("invoice_id") @db.Uuid
  invoice      Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// In the invoice currency
  amount       Decimal        @db.Decimal(12, 2)
  reason       WriteOffReason
  note         String?
  writtenOffAt DateTime       @map("written_off_at") @db.Date
  paymentId    String?        @unique @map("payment_id") @db.Uuid
  payment      Payment?       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now()) @map("created_at")
  createdById  String         @map("created_by") @db.Uuid
  createdBy    User           @relation(fields: [createdById], references: [id])

  @@index([invoiceId])
  @@map("write_offs")
}
