# Postgres connection used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simple_invoice?schema=public

# Use a long random string in any real environment
JWT_SECRET=change-me
# Access token lifetime in seconds
JWT_EXPIRES_IN=3600

PORT=3000
# Comma separated list of allowed origins. Leave empty to allow any origin (dev only)
CORS_ORIGIN=http://localhost:5173

# Account created by `npm run seed`
SEED_USER_EMAIL=reviewer@simpleinvoice.dev
SEED_USER_PASSWORD=Password123!
SEED_USER_NAME=Reviewer

# The business sending the invoices: printed as "From" on PDF invoices.
# Use \n for a line break. Leave any of them empty to hide that line.
COMPANY_NAME=Brightline Studio Pty Ltd
COMPANY_ADDRESS=Level 4, 120 Collins Street\nMelbourne VIC 3000, Australia
COMPANY_EMAIL=billing@brightline.example
COMPANY_PHONE=+61 3 9000 1234
COMPANY_TAX_ID=ABN 12 345 678 901
COMPANY_PAYMENT_DETAILS=Bank transfer to Brightline Studio Pty Ltd\nBSB 062-000, Account 1234 5678. Please quote the invoice number.
