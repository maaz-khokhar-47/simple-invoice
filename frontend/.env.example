# Base URL the app uses for API calls. "/api" works with both the Vite dev
# proxy and the nginx config used in Docker.
VITE_API_URL=/api

# Where the Vite dev server forwards /api requests
API_PROXY_TARGET=http://localhost:3000

# Public address of the app, used for absolute URLs in link previews
# (og:image etc.). Defaults to http://localhost:8080
VITE_SITE_URL=http://localhost:8080
